include LICENSE
include NOTICE
include README.md
include CHANGELOG.md
include pyproject.toml
graft wavhost
graft tests
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude .DS_Store
prune env
prune .pytest_cache
prune wavhost.egg-info
prune dist
prune build
exclude PRD-v2.md
exclude REFACTORING.md
exclude output.wav
